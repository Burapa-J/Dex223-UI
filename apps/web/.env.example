# The Graph gateway API key. SERVER-ONLY: never prefix it with NEXT_PUBLIC_.
# NEXT_PUBLIC_ variables are inlined into the JavaScript every visitor downloads,
# which is how the old NEXT_PUBLIC_AUTH_TOKEN_GQL key leaked. The browser calls
# /api/subgraph/<target> and that route adds this key (mainnet gateway subgraphs;
# Subgraph Studio URLs need no key). Without it those queries return 503.
# Get one at https://thegraph.com/studio/apikeys/ and restrict it there to the
# Dex223 subgraphs, with a monthly budget.
GRAPH_API_KEY=

# Keyed Sepolia RPC providers. SERVER-ONLY, same reason. The browser calls
# /api/rpc/sepolia, which tries Alchemy, then Infura; with neither set it answers
# 503 and the wallet falls back to the public RPCs.
ALCHEMY_API_KEY=
INFURA_API_KEY=

# "development" | "production" — gates test networks and dev-only routes.
NEXT_PUBLIC_ENV=development

# Onramp widget (Onramper) application id. Optional for local development.
NEXT_PUBLIC_ONRAMP_APP_ID=

# Multisig / revenue contract addresses used by the portfolio pages.
NEXT_PUBLIC_MSIG_CONTRACT_ADDRESS=
NEXT_PUBLIC_REVENUE_CONTRACT_ADDRESS=

# Server-side only: SimpleSwap API key used by the cross-chain swap route.
SIMPLE_SWAP_API_KEY=

# Local anvil fork RPC. Set only for local fork testing; leave unset otherwise.
# NEXT_PUBLIC_LOCAL_RPC=http://127.0.0.1:8545

# Dex223 market data API (candles, trades, live stream). When it is unreachable, pool
# charts fall back to the exchange subgraph with hourly and daily data.
NEXT_PUBLIC_MARKET_API_URL=https://api.dex223.io/v1/market
